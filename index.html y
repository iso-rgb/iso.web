<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>İSO SARSILMAZ // Root Access</title>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #0d0208;
            --main-color: #00ff66;
            --dim-color: #008f11;
            --accent-color: #003b00;
            --text-color: #e0e0e0;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Fira Code', monospace;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            overflow-x: hidden;
            position: relative;
        }

        /* Matrix Canvas Background */
        #matrix-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            opacity: 0.15;
        }

        /* Main Overlay Container */
        .container {
            position: relative;
            z-index: 2;
            max-width: 1000px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        /* Header / Glitch Effect */
        header {
            text-align: center;
            margin-bottom: 50px;
        }

        .glitch {
            font-size: 3.5rem;
            font-weight: 700;
            color: var(--main-color);
            text-shadow: 0 0 10px var(--main-color), 0 0 20px var(--main-color);
            position: relative;
            display: inline-block;
            letter-spacing: 2px;
        }

        .sub-title {
            color: #888;
            font-size: 1.1rem;
            margin-top: 10px;
        }

        .status-bar {
            margin-top: 15px;
            font-size: 0.85rem;
            color: var(--dim-color);
        }

        .status-online {
            color: var(--main-color);
            font-weight: bold;
        }

        /* Interactive Terminal Section */
        .terminal-window {
            background: rgba(13, 2, 8, 0.9);
            border: 1px solid var(--dim-color);
            box-shadow: 0 0 25px rgba(0, 255, 102, 0.15);
            border-radius: 6px;
            overflow: hidden;
            margin-bottom: 40px;
        }

        .terminal-header {
            background: #111;
            padding: 10px 15px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid #222;
        }

        .buttons {
            display: flex;
            gap: 8px;
        }

        .btn {
            width: 12px;
            height: 12px;
            border-radius: 50%;
        }

        .btn-red { background: #ff5f56; }
        .btn-yellow { background: #ffbd2e; }
        .btn-green { background: #27c93f; }

        .terminal-title {
            margin-left: 15px;
            font-size: 0.8rem;
            color: #666;
        }

        .terminal-body {
            padding: 20px;
            min-height: 280px;
            max-height: 400px;
            overflow-y: auto;
            font-size: 0.95rem;
        }

        .terminal-output {
            margin-bottom: 15px;
            line-height: 1.6;
        }

        .terminal-input-line {
            display: flex;
            align-items: center;
        }

        .prompt {
            color: var(--main-color);
            margin-right: 10px;
            font-weight: bold;
        }

        .cmd-input {
            background: transparent;
            border: none;
            outline: none;
            color: #fff;
            font-size: 1rem;
            width: 100%;
        }

        /* Feature Cards */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 40px;
        }

        .card {
            background: rgba(20, 20, 20, 0.6);
            border: 1px solid #222;
            padding: 20px;
            border-radius: 4px;
            transition: all 0.3s ease;
        }

        .card:hover {
            border-color: var(--main-color);
            box-shadow: 0 0 15px rgba(0, 255, 102, 0.2);
            transform: translateY(-3px);
        }

        .card h3 {
            color: var(--main-color);
            margin-bottom: 10px;
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .card p {
            color: #aaa;
            font-size: 0.9rem;
            line-height: 1.5;
        }

        /* Social Links */
        .socials {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 50px;
        }

        .social-btn {
            color: var(--main-color);
            text-decoration: none;
            padding: 10px 20px;
            border: 1px solid var(--dim-color);
            border-radius: 4px;
            transition: 0.3s;
            font-weight: bold;
            background: rgba(0, 255, 102, 0.05);
        }

        .social-btn:hover {
            background: var(--main-color);
            color: #000;
            box-shadow: 0 0 15px var(--main-color);
        }

        footer {
            text-align: center;
            margin-top: 60px;
            color: #444;
            font-size: 0.8rem;
        }

        /* Mobile Adjustments */
        @media (max-width: 600px) {
            .glitch { font-size: 2.2rem; }
            .container { padding: 20px 10px; }
        }
    </style>
</head>
<body>

